# Copy to .env and fill in. Never share or commit .env.

# Database password (any long random text)
DB_PASSWORD=change-me

# Password for the dashboard (username: admin). The dashboard is public through the tunnel, so make it strong.
ADMIN_PASSWORD=change-me

# Business time zone, used for opening hours and booking slots
TIMEZONE=Asia/Beirut

# n8n "Ringback Receptionist" workflow webhook (app runs in Docker, n8n on the host)
N8N_WEBHOOK_URL=http://host.docker.internal:5678/webhook/ringback

# WhatsApp Cloud API (from developers.facebook.com > your app > WhatsApp > API setup)
WA_VERIFY_TOKEN=change-me
WA_ACCESS_TOKEN=
WA_APP_SECRET=

# Public address of this app (used for the online booking link)
PUBLIC_URL=https://app.nexfoyz.dev

# Telegram bot (create one with @BotFather in Telegram, paste the token here)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BUSINESS_ID=1

# Client websites: platform domain for free subdomains (e.g. nexfoyz.dev -> layla.nexfoyz.dev). Empty = subdomains off.
SITES_DOMAIN=
# lab (everything, for you) or product (clients see only what they have)
EDITION=lab

# Optional: AI for Teach AI > Coach (import n8n/pulse-coach.json into n8n and activate it)
COACH_WEBHOOK_URL=

# Optional: Claude for Pulse AI (the owner's assistant). Leave empty to keep the default model.
ANTHROPIC_API_KEY=
PULSE_MODEL=claude-opus-5-5
PULSE_EFFORT=medium

# Backup AIs (free tiers). When the main Gemini workflow is busy or out of quota, the AI router tries these in order.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Which AI answers first for the receptionist. Empty = the n8n workflow, then the free backups above.
# Set AI_PRIMARY=anthropic (with ANTHROPIC_API_KEY, optional ANTHROPIC_MODEL) to move the whole platform to Claude in one line.
AI_PRIMARY=

# Encrypts stored channel tokens and keys. Required on a public deployment. Make one with: openssl rand -hex 32
DATA_KEY=

# separate doors (hosts.js): the Lab only at LAB_HOST (admin), client dashboards at APP_HOST
LAB_HOST=lab.nexfoyz.dev
APP_HOST=app.nexfoyz.dev

# signs sign-in sessions (make one with: openssl rand -hex 32)
SESSION_SECRET=

# WhatsApp reminders more than 24 h after the client's last message need a Meta-approved template.
# Body parameters: {{1}} client name, {{2}} service, {{3}} day, {{4}} time, {{5}} business. Without it: email if known, else not sent.
WA_REMINDER_TEMPLATE=
WA_REMINDER_LANG=en

# encrypts the off-site backup copies (scripts/offsite-backup.ps1). Keep a copy in your password manager.
BACKUP_KEY=
