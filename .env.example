# Copy to .env and fill in. Never share or commit .env.

# Database password (any long random text)
DB_PASSWORD=change-me

# Password for the dashboard (username: admin). The dashboard is public through the tunnel, so make it strong.
ADMIN_PASSWORD=change-me

# Business time zone, used for opening hours and booking slots
TIMEZONE=Asia/Beirut

# n8n "Ringback Receptionist" workflow webhook (app runs in Docker, n8n on the host)
N8N_WEBHOOK_URL=http://host.docker.internal:5678/webhook/ringback

# WhatsApp Cloud API (from developers.facebook.com > your app > WhatsApp > API setup)
WA_VERIFY_TOKEN=change-me
WA_ACCESS_TOKEN=
WA_APP_SECRET=

# Public address of this app (used for the online booking link)
PUBLIC_URL=https://app.nexfoyz.dev

# Telegram bot (create one with @BotFather in Telegram, paste the token here)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BUSINESS_ID=1

# Client websites: platform domain for free subdomains (e.g. nexfoyz.dev -> layla.nexfoyz.dev). Empty = subdomains off.
SITES_DOMAIN=
# lab (everything, for you) or product (clients see only what they have)
EDITION=lab

# Optional: AI for Teach AI > Coach (import n8n/pulse-coach.json into n8n and activate it)
COACH_WEBHOOK_URL=
